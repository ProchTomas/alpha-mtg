{
  "name": "alphamtg",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:server": "npm run dev -w @alphamtg/server",
    "dev:web": "npm run dev -w @alphamtg/web",
    "build": "npm run build -w @alphamtg/shared && npm run build -w @alphamtg/server && npm run build -w @alphamtg/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate -w @alphamtg/server",
    "db:migrate": "npm run db:migrate -w @alphamtg/server",
    "ingest": "tsx --conditions=development scripts/ingest-cards.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.19.12": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "esbuild@0.25.12": true,
    "argon2@0.41.1": true,
    "better-sqlite3@12.11.1": true
  }
}
