# /etc/systemd/system/playster.service
[Unit]
Description=Playster (MTG playtesting)
After=network.target

[Service]
Type=simple
User=playster
WorkingDirectory=/opt/playster
Environment=NODE_ENV=production
EnvironmentFile=/opt/playster/.env
ExecStart=/usr/bin/node apps/server/dist/index.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
