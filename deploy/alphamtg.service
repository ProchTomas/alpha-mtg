# /etc/systemd/system/alphamtg.service
[Unit]
Description=Alpha MTG (MTG playtesting)
After=network.target

[Service]
Type=simple
User=alphamtg
WorkingDirectory=/opt/alphamtg
Environment=NODE_ENV=production
EnvironmentFile=/opt/alphamtg/.env
ExecStart=/usr/bin/node apps/server/dist/index.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
